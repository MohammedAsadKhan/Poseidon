{
  "uid": "poseidon-main",
  "title": "Poseidon — Campaign Overview",
  "description": "Phishing simulation metrics — click rates, open rates, AI generation performance",
  "tags": ["poseidon", "security", "phishing"],
  "timezone": "browser",
  "refresh": "15s",
  "time": { "from": "now-24h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total emails sent",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_emails_sent_total)",
          "legendFormat": "Emails sent"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Click rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red",    "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_links_clicked_total) / sum(poseidon_emails_sent_total) * 100",
          "legendFormat": "Click rate %"
        }
      ]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Open rate",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red",    "value": 60 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_emails_opened_total) / sum(poseidon_emails_sent_total) * 100",
          "legendFormat": "Open rate %"
        }
      ]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Credential submissions",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_forms_submitted_total)",
          "legendFormat": "Submissions"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "Phishing reported",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "green",  "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_phishing_reported_total)",
          "legendFormat": "Reported"
        }
      ]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "Active campaigns",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_active_campaigns)",
          "legendFormat": "Active"
        }
      ]
    },

    {
      "id": 7,
      "type": "timeseries",
      "title": "Email events over time",
      "gridPos": { "x": 0, "y": 4, "w": 16, "h": 8 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Sent" },    "properties": [{ "id": "color", "value": { "fixedColor": "#5794F2", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Opened" },  "properties": [{ "id": "color", "value": { "fixedColor": "#73BF69", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Clicked" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2CC0C", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Submitted" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF5959", "mode": "fixed" } }] }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(poseidon_emails_sent_total[5m]) * 60",
          "legendFormat": "Sent"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(poseidon_emails_opened_total[5m]) * 60",
          "legendFormat": "Opened"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(poseidon_links_clicked_total[5m]) * 60",
          "legendFormat": "Clicked"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(poseidon_forms_submitted_total[5m]) * 60",
          "legendFormat": "Submitted"
        }
      ]
    },

    {
      "id": 8,
      "type": "gauge",
      "title": "Overall click rate",
      "gridPos": { "x": 16, "y": 4, "w": 4, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "red",    "value": 30 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_links_clicked_total) / sum(poseidon_emails_sent_total) * 100"
        }
      ]
    },

    {
      "id": 9,
      "type": "gauge",
      "title": "Credential submission rate",
      "gridPos": { "x": 20, "y": 4, "w": 4, "h": 8 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red",    "value": 15 }
            ]
          }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(poseidon_forms_submitted_total) / sum(poseidon_emails_sent_total) * 100"
        }
      ]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "AI email generation latency",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(poseidon_ai_generation_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 latency"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(poseidon_ai_generation_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, rate(poseidon_ai_generation_duration_seconds_bucket[5m]))",
          "legendFormat": "p99 latency"
        }
      ]
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "SMTP send latency",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 7 },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, rate(poseidon_email_send_duration_seconds_bucket[5m]))",
          "legendFormat": "p50 latency"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, rate(poseidon_email_send_duration_seconds_bucket[5m]))",
          "legendFormat": "p95 latency"
        }
      ]
    },

    {
      "id": 12,
      "type": "table",
      "title": "Per-campaign breakdown",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 8 },
      "options": {
        "sortBy": [{ "displayName": "Clicked", "desc": true }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Click rate" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.displayMode", "value": "color-background" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green",  "value": null },
                    { "color": "yellow", "value": 15 },
                    { "color": "red",    "value": 30 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "poseidon_emails_sent_total",
          "legendFormat": "{{campaign_name}}",
          "instant": true,
          "format": "table"
        }
      ]
    },

    {
      "id": 13,
      "type": "logs",
      "title": "Live campaign event log",
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 10 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{container=\"poseidon-engine\"}",
          "legendFormat": "",
          "maxLines": 200
        }
      ]
    }

  ],

  "schemaVersion": 38,
  "version": 1
}
