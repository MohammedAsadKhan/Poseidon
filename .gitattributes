dashboard/vite.config.js        linguist-vendored
dashboard/postcss.config.js     linguist-vendored
dashboard/tailwind.config.js    linguist-vendored
dashboard/eslint.config.js      linguist-vendored

# CSS - styling only, not core logic
*.css  linguist-vendored

# HTML - single index.html entry point, not logic
*.html linguist-vendored

# Explicitly mark core languages so they
# always show up in the language bar
*.rs  linguist-language=Rust
*.jsx linguist-language=JavaScript
*.js  linguist-language=JavaScript
*.yml linguist-language=YAML
*.sql linguist-language=SQL
